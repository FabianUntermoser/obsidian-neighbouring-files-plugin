# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Test vault runtime state + deployed plugin output
# workspace.json churns on every vault open; the plugin dir is build output
# copied in by `make install-test-vault` (main.js/styles.css/manifest.json).
vault/.obsidian/workspace.json
vault/.obsidian/plugins/neighbouring-files/

# Exclude macOS Finder (System Explorer) View States
.DS_Store
